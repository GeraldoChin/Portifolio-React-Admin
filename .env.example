# SMTP settings. Keep the real .env file private and out of version control.
PORT=5000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
CONTACT_TO=destination@example.com
# Optional: set the sender address if your SMTP provider allows it.
# MAIL_FROM=your-email@example.com
# Set this to your deployed frontend origin when the API uses another domain.
# WEB_ORIGIN=https://your-portfolio.example.com
