NODE_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio?schema=public"

# Configure no painel da Cloudinary. Nunca use variáveis VITE_ para segredos.
PROVEDOR_ARMAZENAMENTO=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Obrigatório para autorizar operações administrativas de escrita.
ADMIN_API_KEY=gere-uma-chave-longa-e-aleatoria
